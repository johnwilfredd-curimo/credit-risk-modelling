    {
      "name": "Predict - valid applicant",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));\r\n\r\nconst body = pm.response.json();\r\n\r\npm.test(\"Response has exactly the three contract fields\", () => {\r\n  pm.expect(body).to.have.all.keys(\"probability\", \"credit_score\", \"rating\");\r\n});\r\n\r\npm.test(\"Probability is a valid probability\", () => {\r\n  pm.expect(body.probability).to.be.a(\"number\").and.to.be.within(0, 1);\r\n});\r\n\r\npm.test(\"Credit score sits in the 300-900 band\", () => {\r\n  pm.expect(body.credit_score).to.be.within(300, 900);\r\n});\r\n\r\npm.test(\"Rating is consistent with the score band\", () => {\r\n  const bands = [\r\n    [300, 500, \"Poor\"],\r\n    [500, 650, \"Average\"],\r\n    [650, 750, \"Good\"],\r\n    [750, 901, \"Excellent\"],\r\n  ];\r\n  const expected = bands.find(([lo, hi]) => body.credit_score >= lo && body.credit_score < hi)[2];\r\n  pm.expect(body.rating).to.eql(expected);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"age\": 28,\r\n  \"income\": 1200000,\r\n  \"loan_amount\": 2560000,\r\n  \"loan_tenure_months\": 36,\r\n  \"avg_dpd_per_delinquency\": 20,\r\n  \"delinquency_ratio\": 30,\r\n  \"credit_utilization_ratio\": 30,\r\n  \"num_open_accounts\": 2,\r\n  \"residence_type\": \"Owned\",\r\n  \"loan_purpose\": \"Education\",\r\n  \"loan_type\": \"Unsecured\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/predict_credit_risk",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "predict_credit_risk"
          ]
        }
      },
      "response": []
